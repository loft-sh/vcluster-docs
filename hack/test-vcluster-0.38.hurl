# vCluster 0.38 release tests
# Generated by hack/cutover/gen-release-hurl.py. Regenerate instead of editing.
# Usage: hurl --test --jobs 8 --variable BASE_URL=https://www.vcluster.com hack/test-vcluster-0.38.hurl
# For a password-protected preview, authenticate first with hack/netlify-auth.hurl
# and pass the same --cookie-jar to both runs.

# =====================================================
# Version flip: 0.38.0 is lastVersion, 0.37.0 stays reachable
# =====================================================

# Unversioned docs serve 0.38.0, labeled stable, with the limited availability banner
GET {{BASE_URL}}/docs/vcluster/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "0.38.0"
xpath "string(//meta[@name='docsearch:version_label']/@content)" == "v0.38 Stable"
body contains "is a limited availability release"

# Pinned 0.38.0 URLs collapse to the unversioned URL
GET {{BASE_URL}}/docs/vcluster/0.38.0/overview/architecture
HTTP 301
[Asserts]
header "Location" contains "/docs/vcluster/overview/architecture"
header "Location" not contains "/0.38.0/"

# The 0.38.0 sample page loads as 0.38.0, with the banner
GET {{BASE_URL}}/docs/vcluster/overview/architecture
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "0.38.0"
body contains "is a limited availability release"

# 0.37.0 is still served under its version segment, labeled LTS, without the banner
GET {{BASE_URL}}/docs/vcluster/0.37.0/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "0.37.0"
xpath "string(//meta[@name='docsearch:version_label']/@content)" == "v0.37 (LTS)"
body not contains "is a limited availability release"

# /next/ serves the unreleased version, without the banner
GET {{BASE_URL}}/docs/vcluster/next/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "current"
body not contains "is a limited availability release"


