# Platform 5.0 release tests
# Generated by hack/cutover/gen-release-hurl.py. Regenerate instead of editing.
# Usage: hurl --test --jobs 8 --variable BASE_URL=https://www.vcluster.com hack/test-platform-5.0.hurl
# For a password-protected preview, authenticate first with hack/netlify-auth.hurl
# and pass the same --cookie-jar to both runs.

# =====================================================
# Version flip: 5.0.0 is lastVersion, 4.12.0 stays reachable
# =====================================================

# Unversioned docs serve 5.0.0, labeled stable, with the limited availability banner
GET {{BASE_URL}}/docs/platform/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "5.0.0"
xpath "string(//meta[@name='docsearch:version_label']/@content)" == "v5.0 Stable"
body contains "is a limited availability release"

# Pinned 5.0.0 URLs collapse to the unversioned URL
GET {{BASE_URL}}/docs/platform/5.0.0/tenants/manage-tenants/overview
HTTP 301
[Asserts]
header "Location" contains "/docs/platform/tenants/manage-tenants/overview"
header "Location" not contains "/5.0.0/"

# The 5.0.0 sample page loads as 5.0.0, with the banner
GET {{BASE_URL}}/docs/platform/tenants/manage-tenants/overview
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "5.0.0"
body contains "is a limited availability release"

# 4.12.0 is still served under its version segment, labeled LTS, without the banner
GET {{BASE_URL}}/docs/platform/4.12.0/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "4.12.0"
xpath "string(//meta[@name='docsearch:version_label']/@content)" == "v4.12 (LTS)"
body not contains "is a limited availability release"

# /next/ serves the unreleased version, without the banner
GET {{BASE_URL}}/docs/platform/next/
[Options]
location: true
HTTP 200
[Asserts]
xpath "string(//meta[@name='docusaurus_version']/@content)" == "current"
body not contains "is a limited availability release"


